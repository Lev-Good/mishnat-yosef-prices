{
  "manifest_version": 3,
  "name": "מוסיף למשנת",
  "version": "0.7.1",
  "description": "סל קניות חכם למשנת יוסף: מד תקציב, השוואת מחירים לרשתות, הוספת קבועים בקליק, היסטוריית הזמנות, רשימת איסוף להדפסה ותזכורות.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "מוסיף למשנת",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "cookies",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://mishnatyosef.org/*",
    "https://v2.mishnatyosef.org/*",
    "https://*.mishnatyosef.org/*",
    "https://digital.levtov.uk/*",
    "https://mishnat-yosef-comments.lev-tov-digital.workers.dev/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mishnatyosef.org/*",
        "https://*.mishnatyosef.org/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mishnatyosef.org/*",
        "https://*.mishnatyosef.org/*"
      ],
      "js": ["transport.js", "core.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["feedback.html", "feedback.js"],
      "matches": ["https://mishnatyosef.org/*", "https://*.mishnatyosef.org/*"]
    }
  ]
}
